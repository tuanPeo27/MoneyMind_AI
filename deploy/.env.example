# Copy to ".env" ON THE SERVER (next to docker-compose.prod.yml). Never commit the real file.
# IMAGE_PREFIX and IMAGE_TAG are set by the deploy workflow, do not put them here.

# Public address. DOMAIN has no scheme; PUBLIC_URL has https://. Both must point at the same site.
DOMAIN=moneymind.example.com
PUBLIC_URL=https://moneymind.example.com

# Azure SQL (free offer): copy the ADO.NET connection string from the Azure portal and add the password.
DB_CONNECTION=Server=tcp:YOUR-SERVER.database.windows.net,1433;Database=MoneyMindAI;User ID=YOUR-USER;Password=YOUR-PASSWORD;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=True;Connection Timeout=60

# At least 32 characters each.
SERVICE_KEY=
JWT_KEY=
# base64 of 32 random bytes. Never change it once chat data exists.
ENCRYPTION_MASTER_KEY=

GEMINI_API_KEY=
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Optional
GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
