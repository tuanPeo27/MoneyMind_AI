# Copy this file to ".env" and fill in your own values. ".env" is git-ignored.
# Format: Section__Key=value (double underscore = ":" in .NET configuration).
# Real environment variables take precedence over values in .env.

# Database
ConnectionStrings__DefaultConnection="Server=localhost;Database=MoneyMindAI;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"

# JWT (key must be at least 32 characters; generate a random one)
Jwt__Key=""

# Admin account created by the seeder on first start
Seed__AdminEmail="admin@example.com"
Seed__AdminPassword=""
Seed__AdminFullName="System Admin"

# Google Sign-In: OAuth Client ID of type "Web application" (Google Cloud Console > Google Auth Platform > Clients)
Google__ClientId=""

# Internal Python AI service (ServiceKey must match ai-service/.env)
AIService__ServiceKey=""

# Base64-encoded random 32-byte key. Never change it after chat data has been stored.
Encryption__MasterKey=""

# SMTP. Leave Host empty to print reset links to the log instead of sending mail.
# Gmail: Host=smtp.gmail.com, Port=587, use an App Password, FromAddress = Username.
Smtp__Host=""
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__Username=""
Smtp__Password=""
Smtp__FromAddress=""
Smtp__FromName="MoneyMind AI"

# CORS: allowed web client origins (Section__Key__Index). Not needed when using the Vite dev proxy.
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:3000
