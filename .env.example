# Used by docker-compose.yml. Copy to ".env" (git-ignored) and fill in.

# SQL Server "sa" password: at least 8 characters with upper, lower, digit and symbol.
DB_PASSWORD=

# Shared secret between backend and ai-service, at least 32 characters.
SERVICE_KEY=
GEMINI_API_KEY=
#GEMINI_MODEL_RESPOND=gemini-2.5-flash
#GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# JWT signing key (at least 32 characters) and base64 of 32 random bytes.
# Never change ENCRYPTION_MASTER_KEY once chat data exists.
JWT_KEY=
ENCRYPTION_MASTER_KEY=

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Optional
GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Where users open the site (used for CORS and reset-password links).
WEB_PORT=8080
PUBLIC_URL=http://localhost:8080
