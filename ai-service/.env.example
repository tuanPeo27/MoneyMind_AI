# Copy to .env. Never commit the real API key or service key.
GEMINI_API_KEY=""
# Models are chosen by the system, not by users. The first one answers; when it is out of quota or
# unavailable, the next one in GEMINI_FALLBACK_MODELS (comma separated, in priority order) takes over.
GEMINI_MODEL_RESPOND="gemini-2.5-flash"
GEMINI_FALLBACK_MODELS="gemini-3.5-flash-lite,gemini-3.1-flash-lite"
SERVICE_KEY=""
HOST="127.0.0.1"
PORT=8001
# Whole request (all models it has to try) and one model's share of it, in seconds.
REQUEST_TIMEOUT_SECONDS=45
ATTEMPT_TIMEOUT_SECONDS=25
MAX_OUTPUT_TOKENS=2048
