# Copy to ".env.local" (git-ignored) and fill in. Restart `npm run dev` after changes.

# Backend base URL. Leave empty in development: Vite proxies /api to http://localhost:5146.
VITE_API_URL=

# Google sign-in: the same OAuth Client ID (type "Web application") as Google__ClientId in backend/.env.
# Authorized JavaScript origins must include http://localhost:5173 and http://localhost.
# The Google button is hidden while this is empty.
VITE_GOOGLE_CLIENT_ID=
